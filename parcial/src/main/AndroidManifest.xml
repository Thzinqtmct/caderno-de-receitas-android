<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Caderno">

        <activity
            android:name=".lista.ListaReceitasActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Só é aberta por Intent explícita a partir da lista (exported=false). -->
        <activity
            android:name=".detalhe.DetalheReceitaActivity"
            android:exported="false"
            android:parentActivityName=".lista.ListaReceitasActivity" />
    </application>
</manifest>
